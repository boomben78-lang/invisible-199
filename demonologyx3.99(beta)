local function AlreadyTakenCheck(Obj) return Obj:GetAttribute("Ducko355AlreadyTakenPhoto") == true end
local db3 = false
Take3StarsPhoto.MouseButton1Click:Connect(function()
	if ghostModel:GetAttribute("Hunting") then GhostHuntingInfo(); return end
	if not db3 and EquipPhotoCamera() then
		db3 = true
		local Item, ItemType = nil, nil
		for _, v in pairs(workspace.Items:GetChildren()) do
			if v:GetAttribute("DisplayName") == "Burnt Cross" and not AlreadyTakenCheck(v) then
				v:SetAttribute("Ducko355AlreadyTakenPhoto", true); Item = v; ItemType = "BurntCross"
				plr.Character.HumanoidRootPart.CFrame = v:GetPivot() * CFrame.new(0, 1, 0); break
			end
		end
		if not Item then
			for _, v in pairs(workspace.Interactables:GetChildren()) do
				if v:GetAttribute("PhotoRewardAvailable") and not AlreadyTakenCheck(v) then
					v:SetAttribute("Ducko355AlreadyTakenPhoto", true); Item = v; ItemType = "Interaction"
					plr.Character.HumanoidRootPart.CFrame = v:GetPivot() * CFrame.new(0, 1, 0); break
				end
			end
		end
		if Item then
			game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("TakePhotoWithCamera"):FireServer(
				workspace.CurrentCamera.CFrame,
				{Stars = 3, Type = ItemType, Object = Item, Reward = ItemType == "BurntCross" and 12 or 8}
			)
		else CantTakePhotoInfo() end
		task.wait(1); TpOutside(); task.wait(1); db3 = false
	end
end)

