local function UpdateBehaviorLabel()
	local behaviors = {}
	
	local mapData = AllMaps[currentMap]
	if not mapData then
		BehaviorLabel.Text = "👁️ Hành vi: Đang theo dõi..."
		return
	end
	
	local ghostRoomName = ghostModel:GetAttribute("FavoriteRoom")
	if not ghostRoomName then
		BehaviorLabel.Text = "👁️ Hành vi: Chưa xác định phòng..."
		return
	end
	
	local roomName = ghostRoomName
	if RoomAliases[ghostRoomName] then
		roomName = RoomAliases[ghostRoomName]
	end
	
	local roomGhosts = mapData[roomName]
	if not roomGhosts then
		BehaviorLabel.Text = "👁️ Hành vi: Đang theo dõi..."
		return
	end
	
	local roomGhostNames = {}
	for _, g in ipairs(roomGhosts) do
		roomGhostNames[g.Name] = true
	end
	
	if huntCount >= 2 and roomGhostNames["Demon"] then
		table.insert(behaviors, "Demon (hunt liên tục)")
	end
	
	if ghostOrbToggleCount >= 3 and roomGhostNames["Skinwalker"] then
		table.insert(behaviors, "Skinwalker (orb ảo)")
	end
	
	if throwCount >= 3 and roomGhostNames["Specter"] then
		table.insert(behaviors, "Specter (ném nhiều)")
	end
	
	if throwCount >= 2 and lastThrowTime > 0 and (tick() - lastThrowTime) < 2 and roomGhostNames["Leviathan"] then
		table.insert(behaviors, "Leviathan (ném kép)")
	end
	
	if throwCount >= 5 and roomGhostNames["Entity"] then
		table.insert(behaviors, "Entity (ném hàng loạt)")
	end
	
	if silenceTimer >= 10 and roomGhostNames["Ghoul"] then
		table.insert(behaviors, "Ghoul (Spirit Box im re)")
	end
	
	if #behaviors > 0 then
		BehaviorLabel.Text = "⚠️ Hành vi: " .. table.concat(behaviors, ", ")
		BehaviorLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	else
		BehaviorLabel.Text = "👁️ Hành vi: Đang theo dõi..."
		BehaviorLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
	end
end

