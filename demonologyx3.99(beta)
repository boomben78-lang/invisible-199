local currentRoomGhosts = {}
local GhostScores = {}
local lastRoom = nil

local function ResetScores()
	GhostScores = {}
	for name, _ in pairs(EvidenceMap) do
		GhostScores[name] = 0
	end
end

-- Hàm cộng điểm CHỈ cho ma trong currentRoomGhosts
local function AddScore(ghostName, points)
	if currentRoomGhosts[ghostName] and GhostScores[ghostName] ~= nil then
		GhostScores[ghostName] = GhostScores[ghostName] + points
	end
end

local function UpdateScoreDisplay()
	local topName = nil
	local topScore = -1
	local secondScore = -1
	
	for name, score in pairs(GhostScores) do
		if score > topScore then
			secondScore = topScore
			topScore = score
			topName = name
		elseif score > secondScore then
			secondScore = score
		end
	end
	
	if topName and topScore > 0 then
		if topScore >= 8 and (secondScore == -1 or topScore - secondScore >= 3) then
			ScoreLabel.Text = "✅ XÁC ĐỊNH: " .. topName .. " (" .. topScore .. "đ) [" .. currentMap .. "]"
			ScoreLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
		elseif topScore >= 4 then
			ScoreLabel.Text = "⭐ #1: " .. topName .. " (" .. topScore .. "đ) [" .. currentMap .. "]"
			ScoreLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
		else
			ScoreLabel.Text = "🔍 Top: " .. topName .. " (" .. topScore .. "đ) [" .. currentMap .. "]"
			ScoreLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		end
	else
		ScoreLabel.Text = "🏆 Đang chờ dữ liệu... [" .. currentMap .. "]"
		ScoreLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

