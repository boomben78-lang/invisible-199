				Ghost.TextColor3 = Color3.fromRGB(255, 255, 255)
			end
		else
			if GhostHunting == true then
				Ghost.Text = "Ghost: Hunting"
				Ghost.TextColor3 = Color3.fromRGB(255, 0, 0)
			else
				Ghost.Text = "Ghost: Chilling"
				Ghost.TextColor3 = Color3.fromRGB(255, 255, 255)
			end
		end

		if GhostCurrentRoom then
			CurrentRoom.Text = "Current room: " .. GhostCurrentRoom
		end

		if Temp and TempRoom then
			if Temp < LowestTemp then
				LowestTemp = Temp
				LowestTempRoom = TempRoom
				Temperature.Text = string.format("Temperature: %.1f°C", LowestTemp) .. " (" .. tostring(LowestTempRoom.Name) .. ")"
				if LowestTemp < 0 then
					Temperature.TextColor3 = Color3.fromRGB(0, 255, 0)
					AddScore("Banshee", 0) -- Trigger nếu có trong phòng
				end
			end
		end

		-- Khi Fav Room xuất hiện/thay đổi: Reset điểm, gán điểm khởi tạo theo %
		if GhostFavRoom and GhostFavRoom ~= lastRoom then
			lastRoom = GhostFavRoom
			ResetScores()
			
			local roomName = GhostFavRoom
			if currentMap == "Prison" and RoomAliases[GhostFavRoom] then
				roomName = RoomAliases[GhostFavRoom]
			end
			
			-- Reset danh sách ma trong phòng
			currentRoomGhosts = {}
			local mapData = AllMaps[currentMap]
			if mapData then
				local list = mapData[roomName]
				if list then
					for _, g in ipairs(list) do
						currentRoomGhosts[g.Name] = true
						-- Điểm khởi tạo dựa trên % (làm tròn %/10)
						local initScore = math.floor(g.Percent / 10 + 0.5)
						if initScore < 1 then initScore = 1 end
						GhostScores[g.Name] = initScore
					end
				end
			end
		end

		-- Bằng chứng: CHỈ cộng điểm cho ma trong currentRoomGhosts
		if HandprintsCheck then
			Handprints.Text = "Handprints: Yes"
			Handprints.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.Handprints then AddScore(name, 2) end
			end
		end

		if GhostOrbCheck then
			GhostOrb.Text = "GhostOrb: Yes"
			GhostOrb.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.GhostOrb then AddScore(name, 2) end
			end
			
			-- Theo dõi Skinwalker fake orb
			if not ghostOrbWasVisible then
				ghostOrbToggleCount = ghostOrbToggleCount + 1
			end
			ghostOrbWasVisible = true
		else
			if ghostOrbWasVisible then
				ghostOrbToggleCount = ghostOrbToggleCount + 1
			end
			ghostOrbWasVisible = false
		end

		if InLaser then
			LaserProjector.Text = "Laser Projector: Yes"
			LaserProjector.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.Laser then AddScore(name, 2) end
			end
		end

		if EMFLevelCheck > HighestEMFLevel then
			HighestEMFLevel = EMFLevelCheck
			if EMFLevelCheck == 5 then
				EMF.Text = "EMF level: " .. tostring(HighestEMFLevel)
				EMF.TextColor3 = Color3.fromRGB(0, 255, 0)
				for name, data in pairs(EvidenceMap) do
					if data.EMF5 then AddScore(name, 2) end
				end
			end
		else
			if HighestEMFLevel ~= 5 then
				EMF.Text = "EMF level: " .. tostring(HighestEMFLevel)
			end
		end

		if WitherCheck then
			Wither.Text = "Wither: Yes"
			Wither.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.Wither then AddScore(name, 2) end
			end
		end

		if SpiritBoxCheck then
			SpiritBox.Text = "Spirit Box: Yes"
			SpiritBox.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.SpiritBox then AddScore(name, 2) end
			end
			silenceTimer = 0
		else
			silenceTimer = silenceTimer + 1
		end

		if GhostWritingCheck then
			GhostWriting.Text = "Ghost Writing: Yes"
			GhostWriting.TextColor3 = Color3.fromRGB(0, 255, 0)
			for name, data in pairs(EvidenceMap) do
				if data.GhostWriting then AddScore(name, 2) end
			end
		end
		
		-- Hành vi: Chỉ áp dụng cho ma trong phòng
		if GhostHunting then
			local currentTime = tick()
			if lastHuntTime > 0 then
				local timeBetweenHunts = currentTime - lastHuntTime
				if timeBetweenHunts < 60 then
					huntCount = huntCount + 1
				else
					huntCount = 0
				end
			end
			lastHuntTime = currentTime
		end
		
		local throwingObjects = 0
		for _, obj in pairs(workspace.Items:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Velocity.Magnitude > 10 then
				throwingObjects = throwingObjects + 1
			end
		end
		
		if throwingObjects >= 2 then
			local currentThrowTime = tick()
			if lastThrowTime > 0 and (currentThrowTime - lastThrowTime) < 2 then
				throwCount = throwCount + 1
			else
				throwCount = 1
			end
			lastThrowTime = currentThrowTime
		end
		
		UpdateScoreDisplay()
		UpdateBehaviorLabel()
	end
end)

